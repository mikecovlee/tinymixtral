# Environment for tools/sft + tools/eval scripts. Copy to .env and fill in.

# --- training box (Linux) ---
CONDA_BASE=$HOME/miniconda3          # where conda.sh lives
CONDA_ENV=                           # conda env with torch+transformers (required)
TOKENIZER_SNAP=                      # optional: tokenizer/snapshot dir; default = latest
                                     # models--mikecovlee--tinymixtral HF snapshot

# --- eval machine (remote) ---
PUBLISH_PY=                          # local python used by offload_arm.sh (default: python on PATH)
EVAL_USER=                           # ssh user on the eval machine (required)
EVAL_HOST=                           # eval machine host/IP (required)
EVAL_REPO=                           # repo path on the eval machine, e.g. C:/Users/<user>/tinymixtral-eval
TMUX_EXE=C:\Software\Shell\bin\tmux.exe
EVAL_PY=                             # python on the eval machine (default: python on PATH)
PROXY_URL=                           # optional http(s) proxy for the eval machine

# --- LLM judge ---
DEEPSEEK_API_KEY=                    # or JUDGE_API_KEY; else falls back to opencode auth.json
JUDGE_URL=https://api.deepseek.com/v1/chat/completions
JUDGE_MODEL=deepseek-flash
